# Variables de DESARROLLO. Copiá este archivo como ".env" y completá tus valores.
# El archivo ".env" NO se sube al repositorio.
# (Para testing: ".env.test.example". Para producción / Docker: ".env.production.example".)

# --- Obligatorias (si falta alguna, la app no arranca) ---
PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shipnow
JWT_SECRET=

# --- Opcionales ---
JWT_EXPIRES_IN=1h
# Nivel de logs: debug, http, info, warning, error o fatal (por defecto: debug en desarrollo, info en producción)
LOG_LEVEL=debug
# Swagger en /api/docs: true (por defecto) o false para apagarlo
SWAGGER_ENABLED=true
# URL pública de la API (se muestra en Swagger). Por defecto: http://localhost:PORT
API_BASE_URL=http://localhost:8080
