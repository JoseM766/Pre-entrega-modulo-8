# Variables para PRODUCCIÓN / Docker. Copiá este archivo como ".env.production" y completalo.
# El archivo ".env.production" NO se sube al repositorio ni entra a la imagen.
#
# Uso con Docker:  docker run --env-file .env.production -p 8080:8080 shipnow-api
# (formato KEY=valor, sin comillas)

# --- Obligatorias (si falta alguna, la app no arranca) ---
NODE_ENV=production
PORT=8080
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/shipnow
# En producción debe tener al menos 16 caracteres (usá un valor largo y aleatorio)
JWT_SECRET=willynomequiereja

# --- Opcionales ---
JWT_EXPIRES_IN=1h
# Nivel de logs: debug, http, info, warning, error o fatal (por defecto en producción: info)
LOG_LEVEL=info
# Swagger en /api/docs: true (por defecto) o false para apagarlo
SWAGGER_ENABLED=true
# URL pública de la API (se muestra en Swagger). Por defecto: http://localhost:PORT
API_BASE_URL=http://localhost:8080
